@@ -0,0 +1,566 @@
+/*****************************************************************************
+ * vlc4mvc.c: H.264 MVC 3D stereoscopic decoder for VLC (Nvidia Shield / Android TV)
+ * Powered by edge264-mvc
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_codec.h>
+#include <vlc_picture.h>
+
+#include <edge264mvc.h>
+
+/*****************************************************************************
+ * Module descriptor
+ *****************************************************************************/
+#define VLC4MVC_OUTPUT_TEXT N_("3D Output Format")
+#define VLC4MVC_OUTPUT_LONGTEXT N_("Output format for 3D MVC: 0=Full-SBS (3840x1080), 1=Full-TAB (1920x2160), 2=Half-SBS (3840x2160), 3=Half-TAB (3840x2160), 4=Half-SBS (1920x1080), 5=Half-TAB (1920x1080), 6=2D Only")
+
+#define VLC4MVC_SWAP_TEXT N_("Swap 3D Eyes (Right/Left)")
+#define VLC4MVC_SWAP_LONGTEXT N_("Swap left and right eye views for inverted sync")
+
+#define VLC4MVC_THREADS_TEXT N_("MVC Decoding Threads")
+#define VLC4MVC_THREADS_LONGTEXT N_("Number of worker threads used for decoding (0=auto)")
+
+static const int pi_output_values[] = { 0, 1, 2, 3, 4, 5, 6 };
+static const char * const ppsz_output_descriptions[] = {
+    N_("Full-SBS (3840x1080 - Custom 3D resolution)"),
+    N_("Full-TAB (1920x2160 - Custom 3D resolution)"),
+    N_("Half-SBS (3840x2160 - 4K 3D TV / Projector)"),
+    N_("Half-TAB (3840x2160 - 4K 3D TV / Projector)"),
+    N_("Half-SBS (1920x1080 - Standard 3D TV / Projector)"),
+    N_("Half-TAB (1920x1080 - Standard 3D TV / Projector)"),
+    N_("2D Base View (1920x1080)")
+};
+
+static int OpenDecoder(vlc_object_t *);
+static void CloseDecoder(vlc_object_t *);
+
+vlc_module_begin ()
+    set_shortname("vlc4mvc")
+    set_description(N_("VLC4MVC H.264 MVC 3D decoder"))
+    set_capability("video decoder", 10005)
+    set_callbacks(OpenDecoder, CloseDecoder)
+    set_category(CAT_INPUT)
+    set_subcategory(SUBCAT_INPUT_VCODEC)
+
+    add_integer("vlc4mvc-output", 0, VLC4MVC_OUTPUT_TEXT, VLC4MVC_OUTPUT_LONGTEXT, false)
+        change_integer_list(pi_output_values, ppsz_output_descriptions)
+    add_bool("vlc4mvc-swap-eyes", false, VLC4MVC_SWAP_TEXT, VLC4MVC_SWAP_LONGTEXT, false)
+    add_integer("vlc4mvc-threads", 4, VLC4MVC_THREADS_TEXT, VLC4MVC_THREADS_LONGTEXT, false)
+vlc_module_end ()
+
+/*****************************************************************************
+ * Internal state
+ *****************************************************************************/
+struct decoder_sys_t
+{
+    Edge264MvcDecoder  *decoder;
+    int                 i_output_mode;
+    bool                b_swap_eyes;
+    int                 i_out_width;
+    int                 i_out_height;
+    bool                b_draining;
+    bool                b_extradata_fed;
+};
+
+static void FlushDecoder(decoder_t *p_dec)
+{
+    decoder_sys_t *p_sys = p_dec ? p_dec->p_sys : NULL;
+    if (p_sys)
+    {
+        p_sys->b_draining = false;
+        if (p_sys->decoder)
+            edge264mvc_flush(p_sys->decoder);
+    }
+}
+
+/*****************************************************************************
+ * Output decoded frames
+ *****************************************************************************/
+static void OutputFrames(decoder_t *p_dec)
+{
+    decoder_sys_t *p_sys = p_dec ? p_dec->p_sys : NULL;
+    if (!p_sys || !p_sys->decoder)
+        return;
+
+    Edge264MvcFrame mvc_frame;
+
+    while (edge264mvc_receive_frame(p_sys->decoder, &mvc_frame) == EDGE264MVC_OK)
+    {
+        bool b_is_3d = (mvc_frame.views[1].planes[0] != NULL && p_sys->i_output_mode != 6);
+        int out_w = mvc_frame.width_Y;
+        int out_h = mvc_frame.height_Y;
+        video_multiview_mode_t mv_mode = MULTIVIEW_2D;
+
+        unsigned sar_num = 1, sar_den = 1;
+        if (b_is_3d)
+        {
+            switch (p_sys->i_output_mode)
+            {
+                case 0: // Full-SBS (3840x1080 - Custom 3D resolution)
+                    out_w = mvc_frame.width_Y * 2;
+                    out_h = mvc_frame.height_Y;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_SBS;
+                    break;
+                case 1: // Full-TAB (1920x2160 - Custom 3D resolution)
+                    out_w = mvc_frame.width_Y;
+                    out_h = mvc_frame.height_Y * 2;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_TB;
+                    break;
+                case 2: // Half-SBS (3840x2160 - 4K 3D TV / Projector)
+                    out_w = mvc_frame.width_Y * 2;
+                    out_h = mvc_frame.height_Y * 2;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_SBS;
+                    break;
+                case 3: // Half-TAB (3840x2160 - 4K 3D TV / Projector)
+                    out_w = mvc_frame.width_Y * 2;
+                    out_h = mvc_frame.height_Y * 2;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_TB;
+                    break;
+                case 4: // Half-SBS (1920x1080 - Standard 3D TV / Projector)
+                    out_w = mvc_frame.width_Y;
+                    out_h = mvc_frame.height_Y;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_SBS;
+                    break;
+                case 5: // Half-TAB (1920x1080 - Standard 3D TV / Projector)
+                    out_w = mvc_frame.width_Y;
+                    out_h = mvc_frame.height_Y;
+                    sar_num = 1;
+                    sar_den = 1;
+                    mv_mode = MULTIVIEW_STEREO_TB;
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        // Update format if dimensions changed
+        if (p_sys->i_out_width != out_w || p_sys->i_out_height != out_h)
+        {
+            p_dec->fmt_out.video.i_visible_width  = out_w;
+            p_dec->fmt_out.video.i_visible_height = out_h;
+            p_dec->fmt_out.video.i_width  = (out_w + 15) & ~15;
+            p_dec->fmt_out.video.i_height = (out_h + 15) & ~15;
+            p_dec->fmt_out.video.i_sar_num = sar_num;
+            p_dec->fmt_out.video.i_sar_den = sar_den;
+            p_dec->fmt_out.video.multiview_mode = mv_mode;
+            p_dec->fmt_out.video.i_chroma = p_dec->fmt_out.i_codec = VLC_CODEC_I420;
+
+            if (decoder_UpdateVideoFormat(p_dec) != VLC_SUCCESS)
+            {
+                edge264mvc_release_frame(p_sys->decoder, &mvc_frame);
+                continue;
+            }
+            p_sys->i_out_width = out_w;
+            p_sys->i_out_height = out_h;
+        }
+
+        picture_t *p_pic = decoder_NewPicture(p_dec);
+        if (!p_pic)
+        {
+            edge264mvc_release_frame(p_sys->decoder, &mvc_frame);
+            continue;
+        }
+
+        vlc_tick_t pts = mvc_frame.views[0].pts;
+        p_pic->date = pts;
+        p_pic->b_progressive = true;
+
+        const Edge264MvcView *v_l = p_sys->b_swap_eyes ? &mvc_frame.views[1] : &mvc_frame.views[0];
+        const Edge264MvcView *v_r = p_sys->b_swap_eyes ? &mvc_frame.views[0] : &mvc_frame.views[1];
+
+        if (!b_is_3d || !v_r->planes[0] || p_sys->i_output_mode == 6)
+        {
+            // 2D Blit
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src = v_l->planes[p];
+                for (int y = 0; y < h; y++)
+                    memcpy(dst + y * d_pitch, src + y * s_stride, w);
+            }
+        }
+        else if (p_sys->i_output_mode == 0)
+        {
+            // Full-SBS (3840x1080)
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h; y++)
+                {
+                    memcpy(dst + y * d_pitch, src_l + y * s_stride, w);
+                    memcpy(dst + y * d_pitch + w, src_r + y * s_stride, w);
+                }
+            }
+        }
+        else if (p_sys->i_output_mode == 1)
+        {
+            // Full-TAB (1920x2160)
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h; y++)
+                    memcpy(dst + y * d_pitch, src_l + y * s_stride, w);
+                for (int y = 0; y < h; y++)
+                    memcpy(dst + (h + y) * d_pitch, src_r + y * s_stride, w);
+            }
+        }
+        else if (p_sys->i_output_mode == 2)
+        {
+            // 4K Half-SBS (3840x2160 container)
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h; y++)
+                {
+                    uint8_t *row_dst0 = dst + (y * 2) * d_pitch;
+                    uint8_t *row_dst1 = dst + (y * 2 + 1) * d_pitch;
+                    const uint8_t *sl = src_l + y * s_stride;
+                    const uint8_t *sr = src_r + y * s_stride;
+
+                    memcpy(row_dst0, sl, w);
+                    memcpy(row_dst0 + w, sr, w);
+                    memcpy(row_dst1, sl, w);
+                    memcpy(row_dst1 + w, sr, w);
+                }
+            }
+        }
+        else if (p_sys->i_output_mode == 3)
+        {
+            // 4K Half-TAB (3840x2160 container)
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h; y++)
+                {
+                    uint8_t *row_top = dst + y * d_pitch;
+                    uint8_t *row_bot = dst + (h + y) * d_pitch;
+                    const uint8_t *sl = src_l + y * s_stride;
+                    const uint8_t *sr = src_r + y * s_stride;
+
+                    for (int x = 0; x < w; x++)
+                    {
+                        uint8_t pl = sl[x];
+                        row_top[x * 2]     = pl;
+                        row_top[x * 2 + 1] = pl;
+
+                        uint8_t pr = sr[x];
+                        row_bot[x * 2]     = pr;
+                        row_bot[x * 2 + 1] = pr;
+                    }
+                }
+            }
+        }
+        else if (p_sys->i_output_mode == 4)
+        {
+            // Half-SBS (1920x1080)
+            for (int p = 0; p < 3; p++)
+            {
+                int h = (p == 0) ? mvc_frame.height_Y : mvc_frame.height_C;
+                int w_half = (p == 0) ? mvc_frame.width_Y / 2 : mvc_frame.width_C / 2;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h; y++)
+                {
+                    uint8_t *row_dst = dst + y * d_pitch;
+                    const uint8_t *row_l = src_l + y * s_stride;
+                    const uint8_t *row_r = src_r + y * s_stride;
+                    for (int x = 0; x < w_half; x++)
+                    {
+                        row_dst[x] = row_l[x * 2];
+                        row_dst[w_half + x] = row_r[x * 2];
+                    }
+                }
+            }
+        }
+        else if (p_sys->i_output_mode == 5)
+        {
+            // Half-TAB (1920x1080)
+            for (int p = 0; p < 3; p++)
+            {
+                int h_half = (p == 0) ? mvc_frame.height_Y / 2 : mvc_frame.height_C / 2;
+                int w = (p == 0) ? mvc_frame.width_Y : mvc_frame.width_C;
+                int s_stride = (p == 0) ? mvc_frame.stride_Y : mvc_frame.stride_C;
+                int d_pitch = p_pic->p[p].i_pitch;
+                uint8_t *dst = p_pic->p[p].p_pixels;
+                const uint8_t *src_l = v_l->planes[p];
+                const uint8_t *src_r = v_r->planes[p];
+                for (int y = 0; y < h_half; y++)
+                    memcpy(dst + y * d_pitch, src_l + (y * 2) * s_stride, w);
+                for (int y = 0; y < h_half; y++)
+                    memcpy(dst + (h_half + y) * d_pitch, src_r + (y * 2) * s_stride, w);
+            }
+        }
+
+        decoder_QueueVideo(p_dec, p_pic);
+        edge264mvc_release_frame(p_sys->decoder, &mvc_frame);
+    }
+}
+
+/*****************************************************************************
+ * Send NAL with flow control
+ *****************************************************************************/
+static void SendNalWithRetry(decoder_t *p_dec, const uint8_t *nal, size_t size, vlc_tick_t pts)
+{
+    decoder_sys_t *p_sys = p_dec ? p_dec->p_sys : NULL;
+    if (!p_sys || !p_sys->decoder || !nal || size == 0)
+        return;
+
+    int res;
+    while ((res = edge264mvc_send_nal(p_sys->decoder, nal, size, pts, 0)) == EDGE264MVC_AGAIN)
+    {
+        OutputFrames(p_dec);
+    }
+}
+
+/*****************************************************************************
+ * Parse and feed NALs from buffer (handles Annex-B and AVCC)
+ *****************************************************************************/
+static void FeedBuffer(decoder_t *p_dec, const uint8_t *p_buf, size_t i_buf, vlc_tick_t pts)
+{
+    if (!p_buf || i_buf == 0)
+        return;
+
+    bool b_annexb = (i_buf >= 4 && p_buf[0] == 0 && p_buf[1] == 0 &&
+                     (p_buf[2] == 1 || (p_buf[2] == 0 && p_buf[3] == 1)));
+
+    if (b_annexb)
+    {
+        size_t pos = 0;
+        while (pos < i_buf)
+        {
+            size_t sc_offset = edge264mvc_find_start_code(p_buf + pos, i_buf - pos);
+            if (sc_offset == i_buf - pos) break;
+            pos += sc_offset;
+            size_t sc_len = (pos + 2 < i_buf && p_buf[pos+2] == 1) ? 3 : 4;
+            size_t nal_start = pos + sc_len;
+            pos = nal_start;
+            size_t next_sc = edge264mvc_find_start_code(p_buf + pos, i_buf - pos);
+            size_t nal_len = next_sc;
+            while (nal_len > 0 && p_buf[nal_start + nal_len - 1] == 0)
+                nal_len--;
+            if (nal_len > 0)
+                SendNalWithRetry(p_dec, p_buf + nal_start, nal_len, pts);
+        }
+    }
+    else
+    {
+        // AVCC length-prefixed
+        size_t pos = 0;
+        while (pos + 4 <= i_buf)
+        {
+            uint32_t nal_len = ((uint32_t)p_buf[pos] << 24) |
+                               ((uint32_t)p_buf[pos+1] << 16) |
+                               ((uint32_t)p_buf[pos+2] << 8) |
+                               (uint32_t)p_buf[pos+3];
+            pos += 4;
+            if (pos + nal_len > i_buf) break;
+            if (nal_len > 0)
+                SendNalWithRetry(p_dec, p_buf + pos, nal_len, pts);
+            pos += nal_len;
+        }
+    }
+}
+
+/*****************************************************************************
+ * Feed extradata (AVCDecoderConfigurationRecord / SPS / PPS / Subset SPS)
+ *****************************************************************************/
+static void FeedExtraData(decoder_t *p_dec, const uint8_t *extra, size_t extra_sz)
+{
+    if (!extra || extra_sz == 0)
+        return;
+
+    if (extra_sz >= 7 && extra[0] == 1) // AVCDecoderConfigurationRecord
+    {
+        size_t off = 5;
+        if (off < extra_sz)
+        {
+            int num_sps = extra[off++] & 0x1f;
+            for (int i = 0; i < num_sps && off + 2 <= extra_sz; i++)
+            {
+                uint16_t len = ((uint16_t)extra[off] << 8) | extra[off+1];
+                off += 2;
+                if (off + len <= extra_sz)
+                    SendNalWithRetry(p_dec, extra + off, len, VLC_TICK_INVALID);
+                off += len;
+            }
+        }
+        if (off < extra_sz)
+        {
+            int num_pps = extra[off++];
+            for (int i = 0; i < num_pps && off + 2 <= extra_sz; i++)
+            {
+                uint16_t len = ((uint16_t)extra[off] << 8) | extra[off+1];
+                off += 2;
+                if (off + len <= extra_sz)
+                    SendNalWithRetry(p_dec, extra + off, len, VLC_TICK_INVALID);
+                off += len;
+            }
+        }
+        // If additional MVC SPS / extension bytes exist in extra
+        if (off < extra_sz)
+        {
+            FeedBuffer(p_dec, extra + off, extra_sz - off, VLC_TICK_INVALID);
+        }
+    }
+    else
+    {
+        FeedBuffer(p_dec, extra, extra_sz, VLC_TICK_INVALID);
+    }
+}
+
+/*****************************************************************************
+ * Decode: process an incoming block
+ *****************************************************************************/
+static int Decode(decoder_t *p_dec, block_t *p_block)
+{
+    decoder_sys_t *p_sys = p_dec ? p_dec->p_sys : NULL;
+    if (!p_sys || !p_sys->decoder)
+    {
+        if (p_block) block_Release(p_block);
+        return VLCDEC_SUCCESS;
+    }
+
+    if (!p_block)
+    {
+        // Drain pipeline
+        if (!p_sys->b_draining)
+        {
+            p_sys->b_draining = true;
+            edge264mvc_send_end(p_sys->decoder);
+            OutputFrames(p_dec);
+        }
+        return VLCDEC_SUCCESS;
+    }
+
+    p_sys->b_draining = false;
+
+    if (!p_sys->b_extradata_fed)
+    {
+        p_sys->b_extradata_fed = true;
+        if (p_dec->fmt_in.i_extra > 0 && p_dec->fmt_in.p_extra)
+        {
+            FeedExtraData(p_dec, (const uint8_t *)p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra);
+        }
+    }
+
+    if (p_block->i_flags & BLOCK_FLAG_DISCONTINUITY)
+        FlushDecoder(p_dec);
+
+    if (p_block->i_flags & BLOCK_FLAG_CORRUPTED)
+    {
+        block_Release(p_block);
+        return VLCDEC_SUCCESS;
+    }
+
+    vlc_tick_t pts = (p_block->i_pts > VLC_TICK_INVALID) ? p_block->i_pts : p_block->i_dts;
+    FeedBuffer(p_dec, p_block->p_buffer, p_block->i_buffer, pts);
+    OutputFrames(p_dec);
+
+    block_Release(p_block);
+    return VLCDEC_SUCCESS;
+}
+
+/*****************************************************************************
+ * OpenDecoder: initialize decoder
+ *****************************************************************************/
+static int OpenDecoder(vlc_object_t *p_this)
+{
+    decoder_t *p_dec = (decoder_t *)p_this;
+
+    if (p_dec->fmt_in.i_codec != VLC_CODEC_H264 &&
+        p_dec->fmt_in.i_codec != VLC_FOURCC('a','v','c','1'))
+    {
+        return VLC_EGENERIC;
+    }
+
+    decoder_sys_t *p_sys = vlc_obj_malloc(p_this, sizeof(*p_sys));
+    if (!p_sys)
+        return VLC_ENOMEM;
+
+    memset(p_sys, 0, sizeof(*p_sys));
+    p_sys->i_output_mode = var_InheritInteger(p_this, "vlc4mvc-output");
+    p_sys->b_swap_eyes = var_InheritBool(p_this, "vlc4mvc-swap-eyes");
+
+    Edge264MvcSettings settings;
+    edge264mvc_default_settings(&settings);
+    int threads = var_InheritInteger(p_this, "vlc4mvc-threads");
+    if (threads > 0)
+        settings.n_threads = threads;
+
+    if (edge264mvc_open(&p_sys->decoder, &settings) != EDGE264MVC_OK)
+    {
+        msg_Err(p_dec, "Failed to initialize edge264-mvc decoder");
+        return VLC_EGENERIC;
+    }
+
+    p_dec->fmt_out.i_codec = VLC_CODEC_I420;
+    p_dec->pf_decode = Decode;
+    p_dec->pf_flush  = FlushDecoder;
+    p_dec->p_sys     = p_sys;
+
+    msg_Info(p_dec, "VLC4MVC stereoscopic decoder activated (3D mode: %d)", p_sys->i_output_mode);
+    return VLC_SUCCESS;
+}
+
+/*****************************************************************************
+ * CloseDecoder: free resources
+ *****************************************************************************/
+static void CloseDecoder(vlc_object_t *p_this)
+{
+    decoder_t *p_dec = (decoder_t *)p_this;
+    decoder_sys_t *p_sys = p_dec ? p_dec->p_sys : NULL;
+
+    if (p_sys)
+    {
+        if (p_sys->decoder)
+            edge264mvc_close(&p_sys->decoder);
+        p_dec->p_sys = NULL;
+    }
+}
