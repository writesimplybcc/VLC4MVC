+block_t * MKV_Append_MVC_Addition( block_t *p_block, const uint8_t *p_add, size_t i_add )
+{
+    if( !p_block || !p_add || i_add == 0 )
+        return p_block;
+
+    size_t old_sz = p_block->i_buffer;
+    bool block_is_annexb = (old_sz >= 4 && p_block->p_buffer[0] == 0 && p_block->p_buffer[1] == 0 &&
+                            (p_block->p_buffer[2] == 1 || (p_block->p_buffer[2] == 0 && p_block->p_buffer[3] == 1)));
+
+    bool add_is_annexb = (i_add >= 4 && p_add[0] == 0 && p_add[1] == 0 &&
+                          (p_add[2] == 1 || (p_add[2] == 0 && p_add[3] == 1)));
+
+    if( block_is_annexb == add_is_annexb )
+    {
+        p_block = block_Realloc( p_block, 0, old_sz + i_add );
+        if( likely( p_block ) )
+            memcpy( p_block->p_buffer + old_sz, p_add, i_add );
+        return p_block;
+    }
+
+    if( !block_is_annexb && add_is_annexb )
+    {
+        p_block = block_Realloc( p_block, 0, old_sz + i_add + 32 );
+        if( unlikely( !p_block ) ) return NULL;
+
+        size_t pos = 0;
+        size_t out_pos = old_sz;
+        while( pos < i_add )
+        {
+            while( pos + 3 <= i_add && (p_add[pos] != 0 || p_add[pos+1] != 0 || (p_add[pos+2] != 1 && (pos + 4 > i_add || p_add[pos+2] != 0 || p_add[pos+3] != 1))) )
+                pos++;
+            if( pos >= i_add ) break;
+            size_t sc_len = (p_add[pos+2] == 1) ? 3 : 4;
+            size_t nal_start = pos + sc_len;
+            size_t next = nal_start;
+            while( next + 3 <= i_add && (p_add[next] != 0 || p_add[next+1] != 0 || (p_add[next+2] != 1 && (next + 4 > i_add || p_add[next+2] != 0 || p_add[next+3] != 1))) )
+                next++;
+            if( next > i_add ) next = i_add;
+            size_t nal_size = next - nal_start;
+            if( nal_size > 0 )
+            {
+                p_block->p_buffer[out_pos++] = (nal_size >> 24) & 0xff;
+                p_block->p_buffer[out_pos++] = (nal_size >> 16) & 0xff;
+                p_block->p_buffer[out_pos++] = (nal_size >> 8) & 0xff;
+                p_block->p_buffer[out_pos++] = nal_size & 0xff;
+                memcpy( p_block->p_buffer + out_pos, p_add + nal_start, nal_size );
+                out_pos += nal_size;
+            }
+            pos = next;
+        }
+        p_block->i_buffer = out_pos;
+        return p_block;
+    }
+
+    p_block = block_Realloc( p_block, 0, old_sz + i_add + 32 );
+    if( unlikely( !p_block ) ) return NULL;
+
+    size_t pos = 0;
+    size_t out_pos = old_sz;
+    while( pos + 4 <= i_add )
+    {
+        uint32_t nal_len = (static_cast<uint32_t>(p_add[pos]) << 24) |
+                           (static_cast<uint32_t>(p_add[pos+1]) << 16) |
+                           (static_cast<uint32_t>(p_add[pos+2]) << 8) |
+                           static_cast<uint32_t>(p_add[pos+3]);
+        pos += 4;
+        if( pos + nal_len > i_add ) break;
+        p_block->p_buffer[out_pos++] = 0x00;
+        p_block->p_buffer[out_pos++] = 0x00;
+        p_block->p_buffer[out_pos++] = 0x00;
+        p_block->p_buffer[out_pos++] = 0x01;
+        memcpy( p_block->p_buffer + out_pos, p_add + pos, nal_len );
+        out_pos += nal_len;
+        pos += nal_len;
+    }
+    p_block->i_buffer = out_pos;
+    return p_block;
+}
