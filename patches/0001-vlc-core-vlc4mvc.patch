+static void VLC4MVC_PostProcessSubpictures(spu_t *spu, subpicture_t *output, const video_format_t *fmt_dst)
+{
+    if (!output || !output->p_region)
+        return;
+
+    int screen_ar = var_InheritInteger(spu, "vlc4mvc-screen-ar");
+    int parallax = var_InheritInteger(spu, "vlc4mvc-sub-depth");
+    if (parallax <= 0)
+        parallax = 8; // Default 3D parallax offset in pixels
+
+    int canvas_w = fmt_dst->i_visible_width;
+    int canvas_h = fmt_dst->i_visible_height;
+
+    int sub_scale = var_InheritInteger(spu, "vlc4mvc-sub-scale");
+    int view_w = (fmt_dst->multiview_mode == MULTIVIEW_STEREO_SBS || canvas_w > 1920) ? (canvas_w / 2) : canvas_w;
+    int view_h = (fmt_dst->multiview_mode == MULTIVIEW_STEREO_TB || canvas_h > 1080) ? (canvas_h / 2) : canvas_h;
+
+    // Re-center horizontally if bitmap subtitles were scaled
+    if (sub_scale > 20 && sub_scale < 300 && sub_scale != 100)
+    {
+        for (subpicture_region_t *r = output->p_region; r != NULL; r = r->p_next)
+        {
+            if (r->fmt.i_visible_width > 0 && r->fmt.i_visible_width < (unsigned)view_w)
+            {
+                r->i_x = (view_w - (int)r->fmt.i_visible_width) / 2;
+            }
+        }
+    }
+
+    // CIH 2.39:1 active picture clamp
+    if (screen_ar == 1)
+    {
+        int view_w = (fmt_dst->multiview_mode == MULTIVIEW_STEREO_SBS || canvas_w > 1920) ? (canvas_w / 2) : canvas_w;
+        int view_h = (fmt_dst->multiview_mode == MULTIVIEW_STEREO_TB || canvas_h > 1080) ? (canvas_h / 2) : canvas_h;
+        int active_h = (int)((double)view_w / 2.39);
+        int bar_h = (view_h - active_h) / 2;
+
+        if (bar_h > 0)
+        {
+            int max_y = view_h - bar_h - 20; // 20px margin inside active video
+            for (subpicture_region_t *r = output->p_region; r != NULL; r = r->p_next)
+            {
+                int r_h = r->fmt.i_visible_height ? r->fmt.i_visible_height : 60;
+                if (r->i_y + r_h > max_y)
+                {
+                    r->i_y = max_y - r_h;
+                    if (r->i_y < bar_h) r->i_y = bar_h;
+                }
+            }
+        }
+    }
+
+    // 3D stereoscopic subtitle duplication (Left eye / Right eye parallax)
+    if (fmt_dst->multiview_mode == MULTIVIEW_STEREO_SBS || canvas_w > 1920)
+    {
+        int eye_w = canvas_w / 2;
+        subpicture_region_t *orig_head = output->p_region;
+        subpicture_region_t **tail_ptr = &output->p_region;
+        while (*tail_ptr) tail_ptr = &(*tail_ptr)->p_next;
+
+        for (subpicture_region_t *r = orig_head; r != NULL; r = r->p_next)
+        {
+            r->i_x -= parallax;
+            if (r->i_x < 0) r->i_x = 0;
+
+            subpicture_region_t *copy = subpicture_region_Copy(r);
+            if (copy)
+            {
+                copy->i_x = r->i_x + eye_w + 2 * parallax;
+                copy->p_next = NULL;
+                *tail_ptr = copy;
+                tail_ptr = &copy->p_next;
+            }
+        }
+    }
+    else if (fmt_dst->multiview_mode == MULTIVIEW_STEREO_TB || canvas_h > 1080)
+    {
+        int eye_h = canvas_h / 2;
+        subpicture_region_t *orig_head = output->p_region;
+        subpicture_region_t **tail_ptr = &output->p_region;
+        while (*tail_ptr) tail_ptr = &(*tail_ptr)->p_next;
+
+        for (subpicture_region_t *r = orig_head; r != NULL; r = r->p_next)
+        {
+            r->i_x -= parallax;
+
+            subpicture_region_t *copy = subpicture_region_Copy(r);
+            if (copy)
+            {
+                copy->i_x = r->i_x + 2 * parallax;
+                copy->i_y = r->i_y + eye_h;
+                copy->p_next = NULL;
+                *tail_ptr = copy;
+                tail_ptr = &copy->p_next;
+            }
+        }
+    }
+}
